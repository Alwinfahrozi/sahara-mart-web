# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# WhatsApp Business Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx

# Contact Form Email
CONTACT_EMAIL=admin@saharamart.com

# ⚠️ SECURITY WARNING
# - NEVER commit .env or .env.local to git!
# - Copy this file to .env.local and fill with actual values
# - Service role key = full database access - keep secret!
# - Use Vercel environment variables in production
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your actual Supabase credentials from: https://supabase.com/dashboard
# 3. Get values from: Supabase Dashboard → Settings → API
# 4. NEVER commit .env or .env.local files!
#
# Production Deployment (Vercel):
# 1. Go to: Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Add all variables from this file with actual production values
# 3. Deploy
